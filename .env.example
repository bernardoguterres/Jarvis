# Copy this file to backend/.env (or export these as real environment
# variables) for local development. No secrets belong in this file or in Git.

# Where Jarvis stores personal data (database, documents, backups, exports).
# Defaults to ~/JarvisData if unset. Never point this at the Git repository.
JARVIS_DATA_DIR=~/JarvisData

# The local Vite dev server origin the backend accepts CORS requests from.
CORS_ORIGIN=http://localhost:5173

# Read by the frontend (Vite) to reach the backend API. Prefix required by Vite.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Hermes provider configuration (backend/.env) ---
# Non-secret. The Hermes API server's base URL (its own default: 127.0.0.1:8642).
HERMES_BASE_URL=http://127.0.0.1:8642

# Non-secret. A DISPLAY LABEL ONLY — never sent to Hermes (see docs/ARCHITECTURE.md
# §7a). Update this to match whatever the 'jarvis' Hermes profile is actually
# configured for (`jarvis config set model` / `jarvis setup model`); it only
# affects what shows up in Message.model_used, agent_runs, and the HUD.
# Currently configured: GPT-5.6 Terra via OpenAI Codex OAuth.
HERMES_MODEL=openai-codex/gpt-5.6-terra

# Non-secret. Per-request timeout in seconds when calling Hermes.
HERMES_REQUEST_TIMEOUT_SECONDS=30

# Non-secret. How many recent messages from the same conversation to include
# as context on each turn.
HERMES_MAX_CONTEXT_MESSAGES=20

# Non-secret. Name of the dedicated Hermes profile Jarvis uses.
HERMES_PROFILE_NAME=jarvis

# Non-secret. The 'hermes' executable to invoke for profile export/import.
HERMES_CLI_COMMAND=hermes

# SECRET — do not set a value here. This is the Hermes API server's bearer
# token (API_SERVER_KEY), generated once via `openssl rand -hex 32` and
# stored only in the real backend/.env (permission 600, gitignored, never
# exported/backed up). It is a DIFFERENT secret from whatever model
# credential Hermes uses (currently an OpenAI Codex OAuth token) — that
# credential is configured separately, directly in Hermes, via `jarvis setup
# model`, and never touches this file or this backend at all.
HERMES_API_BEARER_TOKEN=

# --- Voice configuration (backend/.env), Phase 5 ---
# Non-secret. faster-whisper model size; larger is more accurate but slower
# and downloads more weight data on first real transcription.
WHISPER_MODEL_SIZE=base

# Non-secret. faster-whisper inference device.
WHISPER_DEVICE=cpu

# Non-secret. faster-whisper compute type (int8 is a reasonable CPU default).
WHISPER_COMPUTE_TYPE=int8

# Non-secret. Edge TTS voice name for spoken responses.
EDGE_TTS_VOICE=en-GB-RyanNeural
